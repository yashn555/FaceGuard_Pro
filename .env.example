# FaceGuard Pro Environment Variables
# Copy this file to .env and fill in your values

# Security Settings
FALLBACK_PASSWORD=CHANGE_ME
MAX_ATTEMPTS=3
FACE_TOLERANCE=0.6
SHUTDOWN_ON_MAX_ATTEMPTS=true

# Email Settings (Gmail App Password required)
EMAIL_ENABLED=true
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_RECEIVER=your_email@gmail.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Paths (Windows - uses %USERPROFILE%)
APP_DATA_PATH=%USERPROFILE%/FaceGuard
PHOTOS_PATH=%USERPROFILE%/FaceGuard/photos
LOGS_PATH=%USERPROFILE%/FaceGuard/logs
BACKUPS_PATH=%USERPROFILE%/FaceGuard/backups
DATABASE_PATH=%USERPROFILE%/FaceGuard/faceguard.db
KNOWN_FACE_PATH=%USERPROFILE%/FaceGuard/photos/known_face.pkl
ENCRYPTION_KEY_PATH=%USERPROFILE%/FaceGuard/key.key

# Dashboard Settings
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000
DASHBOARD_DEBUG=false

# Daemon Settings
DAEMON_ENABLED=true
DAEMON_AUTO_START=true